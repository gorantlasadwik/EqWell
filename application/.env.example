# Flask app settings
FLASK_SECRET_KEY=change-me
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
PORT=5000
EQWELL_DB_PATH=eqwell_scores.db
# Vercel serverless writes must use /tmp
# EQWELL_DB_PATH=/tmp/eqwell_scores.db
EQWELL_TRUST_PROXY=0
SESSION_COOKIE_SECURE=0
REMEMBER_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
SESSION_TTL_HOURS=12
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.1-8b-instant
EQWELL_ENABLE_MOCK_LOGINS=1
EQWELL_SEED_MOCK_DATA=1

# Model and extension signal settings
HUGGINGFACE_API_TOKEN=hf_your_token_here
HF_EMOTION_API_URL=https://router.huggingface.co/hf-inference/models/j-hartmann/emotion-english-distilroberta-base
EQWELL_JWT_SECRET=change-me
EQWELL_JWT_ALGORITHM=HS256
EXTENSION_HEARTBEAT_MAX_AGE_SECONDS=75
EQWELL_DEBUG_SIGNAL_LOGS=1
EXTENSION_MIN_INSTALL_AGE_SECONDS=12
EXTENSION_MIN_CONSENT_AGE_SECONDS=8
EXTENSION_BATCH_WINDOW_HOURS=12
EXTENSION_BATCH_MAX_EVENTS=400
EXTENSION_REPEAT_WINDOW_SECONDS=120
EXTENSION_REPEAT_PENALTY_STEP_1=2
EXTENSION_REPEAT_PENALTY_STEP_2=4
EXTENSION_REPEAT_PENALTY_STEP_3=6
EXTENSION_REPEAT_PENALTY_STEP_4=9
COUNSELLOR_DEFAULT_SCORE=3
EQWELL_WHATSAPP_MODE=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Google Fit OAuth
GOOGLE_FIT_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_FIT_CLIENT_SECRET=your-google-client-secret
GOOGLE_FIT_REDIRECT_URI=http://127.0.0.1:5000/api/student/google-fit/callback
# Production example:
# GOOGLE_FIT_REDIRECT_URI=https://your-vercel-domain.vercel.app/api/student/google-fit/callback
GOOGLE_FIT_SCOPES=https://www.googleapis.com/auth/fitness.activity.read https://www.googleapis.com/auth/fitness.sleep.read
